<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>ChzzkApi_CS</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.3</Version>
    <PackageId>ChzzkApi-CS</PackageId>
    <Authors>Null38</Authors>
    <Description>Chzzk Open API C# client library</Description>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="9.0.19" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.19" />
    <PackageReference Include="SocketIOClient" Version="4.0.5" />
  </ItemGroup>

</Project>
