<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>ChzzkApi</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <PackageId>ChzzkApi-CS</PackageId>
    <Authors>Null38</Authors>
    <Description>Chzzk Open API C# client library</Description>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>chzzk</PackageTags>
    <RepositoryUrl>https://github.com/Null38/ChzzkApi-CS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="9.0.19" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.19" />
    <PackageReference Include="SocketIOClient" Version="4.0.5" />
  </ItemGroup>

</Project>
